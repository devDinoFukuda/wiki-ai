{
  "markers": [
    "TODO",
    "FIXME",
    "HACK",
    "NOTE",
    "XXX"
  ],
  "directives": [
    "type: ignore",
    "pragma",
    "noqa",
    "fmt:",
    "pylint:"
  ],
  "banned_terms": [
    "legacy",
    "legado",
    "compat",
    "deprecated"
  ],
  "external_tokens": [
    "w:compat",
    "compatSetting",
    "w:compatSetting"
  ],
  "provider_names": [
    "claude",
    "codex",
    "devin",
    "cursor",
    "windsurf",
    "antigravity",
    "anthropic",
    "openai"
  ],
  "provider_adapter_package": "wiki_ai.agent.providers",
  "application_area": "app",
  "layers": {
    "app": [
      "*"
    ],
    "investigation": [
      "repository",
      "knowledge",
      "agent"
    ],
    "publishing": [
      "knowledge"
    ],
    "ingestion": [
      "knowledge",
      "agent"
    ],
    "knowledge": [],
    "repository": [],
    "agent": [],
    "quality": []
  },
  "removed_packages": [
    "scripts",
    "scripts/codescan",
    "scripts/sbindex",
    "scripts/wk"
  ],
  "removed_commands": [
    "promote",
    "compile",
    "docx",
    "finish",
    "ingest-legacy",
    "migrate",
    "code",
    "index",
    "search",
    "get",
    "audit",
    "lint",
    "check",
    "engines",
    "store"
  ],
  "allowed_console_scripts": [
    "wiki-ai"
  ],
  "max_production_file_lines": 1000,
  "public_api": [
    "wiki_ai.quality.*",
    "wiki_ai.app.ports",
    "wiki_ai.agent.protocol",
    "wiki_ai.agent.providers.*",
    "wiki_ai.__main__"
  ],
  "dead_code_allow": [
    {
      "symbol": "wiki_ai.agent.providers.broker:daemon_threads",
      "reason": "socketserver reads this class attribute"
    },
    {
      "symbol": "wiki_ai.agent.providers.broker:allow_reuse_address",
      "reason": "socketserver reads this class attribute"
    }
  ]
}
